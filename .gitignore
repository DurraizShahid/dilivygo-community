.env

# Node / TypeScript
node_modules
**/node_modules
dist
build
coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript incremental build cache (machine-specific, regenerated by tsc)
*.tsbuildinfo

# Turborepo
.turbo

# Next.js
.next

# Env / local config
.env.*
!.env.example
.DS_Store
*.local
.env


# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
Thumbs.db

# Browser-automation MCP scratch output (console logs, page snapshots)
.playwright-mcp/

# Docker / runtime
.docker
*.pid

# Backend local uploads (platform logos, etc.)
apps/server/data/uploads/

# Mobile release secrets & assets (never commit signing keys, push creds, or
# rendered screenshots — see MOBILE_RELEASE.md).
secrets/
apps/*-mobile/google-services.json
apps/*-mobile/GoogleService-Info.plist
apps/*-mobile/screenshots/
# Expo prebuild output (regenerated via `expo prebuild`; keeps EAS `--require-commit`
# uploads clean and prevents accidental commits of generated native code).
apps/*-mobile/android/
apps/*-mobile/ios/
apps/*-mobile/*-export/

