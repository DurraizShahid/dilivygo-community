{
  "name": "@dilivygo/pos-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "npm run dev --workspace=@dilivygo/pos",
    "dev:electron": "wait-on tcp:3004 && electron .",
    "build": "npm run build --workspace=@dilivygo/pos",
    "dist": "npm run build && electron-builder",
    "test": "node --test"
  },
  "devDependencies": {
    "@dilivygo/pos": "*",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "electron-builder": "^24.13.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.dilivygo.pos",
    "productName": "Dilivygo POS",
    "directories": {
      "output": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "trusted-origin.js"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
