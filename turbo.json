{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "16",
  "globalEnv": ["SENTRY_DSN", "CLERK_SECRET_KEY", "LANDING_ORIGINS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    }
  }
}
