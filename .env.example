# Dilivygo Community Edition — environment template.
# Copy to `.env` and fill in. NEVER commit real secrets.
#
# Demo-safe fallbacks: every external service below is OPTIONAL. Unset keys get
# safe local fallbacks so `docker compose up` gives a fully clickable demo with
# zero third-party accounts (see notes per section).

# ---------- Edition ----------
DILIVYGO_EDITION=community # default; 'community' disables commercial code paths
# Mobile (Expo) build-time mirror of the edition. The customer mobile app reads
# this (not DILIVYGO_EDITION) to gate multi-vendor aggregation: 'community'
# (default) scopes the app to the single configured shop; any other value
# re-enables EXPO_PUBLIC_RESTAURANT_REFS multi-ref aggregation.
# EXPO_PUBLIC_DILIVYGO_EDITION=community

# ---------- Database (required) ----------
# The server talks to Postgres through PostgREST (Supabase-compatible REST).
# Docker Compose provides both automatically — the values below match it.
# For a hosted Supabase project instead, replace with your project URL + key.
SUPABASE_URL=http://postgrest:3000 # in compose; use http://localhost:3000 from host
SUPABASE_DB_URL=postgres://dilivygo:dilivygo@postgres:5432/dilivygo # migrations only
SUPABASE_SERVICE_ROLE_KEY=<redacted>
# ^ demo-only key, signed by the compose PostgREST_JWT_SECRET below. The server
# accepts any legacy `service_role` JWT (see lib/storage.js). REGENERATE both
# for anything beyond local demo use.
POSTGREST_JWT_SECRET=<redacted>

# ---------- Redis (optional) ----------
REDIS_URL= # sessions, rate limits, WS fanout, job locks. Unset = single-process
           # in-memory fallback (fine for demo; set it for production).

# ---------- Auth/session secrets (required in production) ----------
SESSION_SECRET=<redacted>
JWT_SECRET=<redacted>

# ---------- Stripe (optional — dummy processor fallback) ----------
# Unset = orders use a dummy payment processor; checkout still works end-to-end.
STRIPE_SECRET_KEY= # test (sk_test_*) vs live (sk_live_*)
STRIPE_WEBHOOK_SECRET=<redacted>
STRIPE_CONNECT_DEFAULT_COUNTRY= # optional — ISO alpha-2 for new Express accounts

# ---------- Email (optional — logs instead of sending) ----------
EMAIL_PROVIDER= # only `resend` implemented; default resend
EMAIL_API_KEY=<redacted>
EMAIL_FROM_ADDRESS= # default noreply@dilivygo.app
# Unset EMAIL_API_KEY = emails are logged, not sent. Nothing breaks.

# ---------- SMS / OTP (optional — OTP bypass in demo) ----------
TWILIO_ACCOUNT_SID= # all three required to enable SMS; unset = SMS no-op
TWILIO_AUTH_TOKEN=<redacted>
TWILIO_PHONE_NUMBER=

# ---------- Push notifications (optional — skipped if unset) ----------
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_MAPS_API_KEY= # optional — maps in customer/vendor apps

# ---------- Nango managed OAuth (optional — integrations UI degrades gracefully) ----------
NANGO_SECRET_KEY=
NANGO_API_BASE_URL= # default https://api.nango.dev

# ---------- Integration webhook secrets (only if you use n8n/Zapier/Make) ----------
INTEGRATION_WEBHOOK_ENCRYPTION_KEY= # 32+ random bytes, AES-GCM

# ---------- POS hardware (optional) ----------
POS_HARDWARE_DRAWER_ENABLED= # '1' enables cash-drawer kicks via the pos-desktop bridge

# ---------- Frontend build-time API origins ----------
NEXT_PUBLIC_API_URL= # all Next.js apps — backend origin, e.g. http://localhost:8080
EXPO_PUBLIC_API_URL= # all Expo apps — backend origin (dev falls back to LAN host)

# ---------- Commercial features: NOT part of Community Edition ----------
# The following exist in code only as disabled stubs and are intentionally
# undocumented here: SAAS_BILLING_ENABLED, FEATURE_TALENT_ENABLED,
# CLERK_SECRET_KEY, domain-health jobs. Leave them unset.
